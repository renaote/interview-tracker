<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.renate.tracker.controller.MainController"
            prefWidth="1000" prefHeight="650">

    <!-- Top: dashboard numbers + search bar -->
    <top>
        <VBox spacing="10">
            <padding><Insets top="14" right="16" bottom="6" left="16"/></padding>
            <HBox spacing="12" fx:id="statCardBox" />
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by company or role..." prefWidth="280"/>
                <ComboBox fx:id="stageFilterBox" promptText="Filter by stage"/>
                <Button text="Clear" onAction="#onClearFilters"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Add company" onAction="#onAddCompany" defaultButton="true"/>
            </HBox>
        </VBox>
    </top>

    <!-- Middle: the table showing every application -->
    <center>
        <TableView fx:id="companyTable">
            <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
            <columns>
                <TableColumn fx:id="colName" text="Company" prefWidth="160"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="180"/>
                <TableColumn fx:id="colStage" text="Stage" prefWidth="110"/>
                <TableColumn fx:id="colDeadline" text="Deadline" prefWidth="100"/>
                <TableColumn fx:id="colNotes" text="Notes" prefWidth="260"/>
            </columns>
        </TableView>
    </center>

    <!-- Bottom: buttons for whatever row is selected -->
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding><Insets top="8" right="16" bottom="14" left="16"/></padding>
            <Button text="Edit selected" onAction="#onEditCompany"/>
            <Button text="Advance stage" onAction="#onAdvanceStage"/>
            <Button text="Delete selected" onAction="#onDeleteCompany"/>
        </HBox>
    </bottom>
</BorderPane>